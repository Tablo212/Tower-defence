</div>

<div id="boss-banner">MEGA-BOSS APPROACHING!</div>

<div id="hud-bottom">
  <div id="tower-inspector">
    <div>
      <strong id="insp-title" style="color:#00f0ff;">Tower Lv. 1</strong>
      <div id="insp-stats" style="font-size:12px; color:#9ab8d8;">DMG: 20 | RNG: 4.5</div>
