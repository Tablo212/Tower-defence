<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>3D Neon Bastion - Orbit & Arsenal Edition</title>
  <style>
    * { box-sizing: border-box; user-select: none; }
    body {
      margin: 0;
      overflow: hidden;
      background: #0d0f17;
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
    }
    #hud {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
    }
    .panel {
      background: rgba(18, 22, 34, 0.92);
      border: 1px solid #323b54;
      padding: 10px 16px;
      border-radius: 8px;
      display: flex;
      gap: 16px;
      font-weight: bold;
      font-size: 15px;
      pointer-events: auto;
    }
    .stat span { color: #00e5ff; }
    .lives span { color: #ff4757; }
    .gold span { color: #ffd32a; }
    button {
      background: #2b334a;
      color: #fff;
      border: 1px solid #485478;
      padding: 6px 12px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover { background: #3c4766; }

    #inspector {
      position: absolute;
      top: 66px;
      left: 12px;
      width: 280px;
      background: rgba(18, 22, 34, 0.96);
      border: 1px solid #00e5ff;
      border-radius: 8px;
      padding: 12px;
      display: none;
      flex-direction: column;
      gap: 8px;
      font-size: 13px;
      z-index: 5;
    }
    #inspector h3 { margin: 0; color: #00e5ff; font-size: 16px; display: flex; justify-content: space-between; }
    .insp-stats { color: #dfe4ea; line-height: 1.5; }
    .prio-row { display: flex; gap: 4px; margin-top: 2px; }
    .prio-btn { flex: 1; padding: 4px 2px; font-size: 11px; background: #1b2030; }
    .prio-btn.active { background: #00a8ff; border-color: #00e5ff; color: #000; }
    .insp-actions { display: flex; gap: 8px; margin-top: 4px; }
    #btn-upgrade { flex: 2; background: #1e90ff; border-color: #70a1ff; }
    #btn-upgrade:disabled { background: #2f3542; border-color: #57606f; color: #747d8c; cursor: not-allowed; }
    #btn-sell { flex: 1; background: #ff4757; border-color: #ff6b81; }

    #tower-bar {
      position: absolute;
      bottom: 12px;
      left: 12px;
      right: 12px;
      background: rgba(18, 22, 34, 0.92);
      border: 1px solid #323b54;
      border-radius: 8px;
      padding: 8px;
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      gap: 4px;
    }
    .tower-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 6px 2px;
      font-size: 10.5px;
      text-align: center;
      border-radius: 5px;
      background: #1b2030;
      border: 1px solid #2e3750;
      cursor: pointer;
    }
    .tower-btn.selected {
      border-color: #00e5ff;
      background: #15394a;
    }
    .tower-btn .cost { color: #ffd32a; font-weight: bold; margin-top: 2px; }
    .tower-btn .tag { font-size: 9px; color: #a4b0be; }

    #overlay {
      position: absolute;
      inset: 0;
      background: rgba(10, 12, 20, 0.92);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }
    #overlay h1 { font-size: 40px; margin: 0 0 6px 0; color: #00e5ff; }
    #overlay p { color: #a4b0be; margin: 0 0 20px 0; }
    .setup-label { font-size: 13px; color: #ffd32a; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-weight: bold; }
    .select-row { display: flex; gap: 10px; margin-bottom: 22px; flex-wrap: wrap; justify-content: center; }
    .opt-btn { padding: 10px 18px; font-size: 15px; background: #1b2030; border: 1px solid #3c4766; }
    .opt-btn.active { background: #00a8ff; border-color: #00e5ff; color: #000; }
    #start-btn { padding: 14px 36px; font-size: 19px; background: #2ed573; border-color: #7bed9f; color: #000; }
    #start-btn:hover { background: #7bed9f; }

    #tooltip {
      position: absolute;
      bottom: 86px;
      left: 12px;
      background: rgba(18, 22, 34, 0.92);
      border: 1px solid #323b54;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      color: #dfe4ea;
    }
  </style>
</head>
<body>

  <div id="hud">
    <div class="panel">
      <div class="gold">Gold: <span id="gold">175</span></div>
      <div class="lives">Lives: <span id="lives">20</span></div>
      <div class="stat">Wave: <span id="wave">1</span> / 50</div>
      <div class="stat">Map: <span id="map-label">Serpentine</span></div>
      <div class="stat">Mode: <span id="diff-label">Normal</span></div>
    </div>
    <div class="panel">
      <button id="cam-reset-btn">Reset Cam</button>
      <button id="mute-btn">Sound: ON</button>
      <button id="speed-btn">Speed: 1x</button>
      <button id="wave-btn">Next Wave</button>
    </div>
  </div>

  <div id="inspector">
    <h3><span id="insp-name">Tower</span> <span id="insp-lvl">Lv. 1</span></h3>
    <div class="insp-stats" id="insp-stats"></div>
    <div id="prio-container">
      <div style="font-size:11px; color:#a4b0be; margin-bottom:3px;">Target Priority:</div>
      <div class="prio-row">
        <button class="prio-btn" data-prio="first">First</button>
        <button class="prio-btn" data-prio="strong">Strong</button>
        <button class="prio-btn" data-prio="close">Close</button>
        <button class="prio-btn" data-prio="last">Last</button>
      </div>
    </div>
    <div class="insp-actions">
      <button id="btn-upgrade">Upgrade ($50)</button>
      <button id="btn-sell">Sell ($30)</button>
    </div>
  </div>

  <div id="tooltip">Left-click to build/upgrade • Right-click + drag to orbit 3D camera • Scroll wheel to zoom.</div>
  <div id="tower-bar"></div>

  <div id="overlay">
    <h1 id="overlay-title">3D NEON BASTION</h1>
    <p id="overlay-sub">Choose a Battlefield & Difficulty — Survive 50 Waves & Defeat 5 Bosses</p>

    <div class="setup-label">1. Select Map</div>
    <div class="select-row" id="map-buttons"></div>

    <div class="setup-label">2. Select Difficulty</div>
    <div class="select-row" id="diff-buttons">
      <button class="opt-btn" data-diff="easy">Easy</button>
      <button class="opt-btn active" data-diff="normal">Normal</button>
      <button class="opt-btn" data-diff="hard">Hard</button>
      <button class="opt-btn" data-diff="nightmare">Nightmare</button>
    </div>

    <button id="start-btn">LAUNCH BATTLE</button>
  </div>

