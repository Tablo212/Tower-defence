    // --- PROCEDURAL WEB AUDIO SOUND FX ENGINE ---
    let audioCtx = null;
    let soundMuted = false;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === "suspended") audioCtx.resume();
    }

    function playSound(type) {
      if (soundMuted || !audioCtx) return;
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      switch (type) {
        case "laser":
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(720, now);
          osc.frequency.exponentialRampToValueAtTime(180, now + 0.09);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
          osc.start(now); osc.stop(now + 0.09);
          break;
        case "twin":
          osc.type = "triangle";
          osc.frequency.setValueAtTime(880, now);
          osc.frequency.exponentialRampToValueAtTime(320, now + 0.07);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
          osc.start(now); osc.stop(now + 0.07);
          break;
        case "frost":
          osc.type = "sine";
          osc.frequency.setValueAtTime(1250, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.14);
          gain.gain.setValueAtTime(0.07, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
          osc.start(now); osc.stop(now + 0.14);
          break;
        case "venom":
          osc.type = "sine";
          osc.frequency.setValueAtTime(280, now);
          osc.frequency.linearRampToValueAtTime(460, now + 0.11);
          gain.gain.setValueAtTime(0.07, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.11);
          osc.start(now); osc.stop(now + 0.11);
          break;
        case "explosion":
          osc.type = "square";
          osc.frequency.setValueAtTime(130, now);
          osc.frequency.exponentialRampToValueAtTime(32, now + 0.22);
          gain.gain.setValueAtTime(0.11, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
          osc.start(now); osc.stop(now + 0.22);
          break;
        case "sniper":
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(1400, now);
          osc.frequency.exponentialRampToValueAtTime(95, now + 0.18);
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
          osc.start(now); osc.stop(now + 0.18);
          break;
        case "zap":
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.linearRampToValueAtTime(980, now + 0.05);
          osc.frequency.exponentialRampToValueAtTime(210, now + 0.13);
          gain.gain.setValueAtTime(0.07, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.13);
          osc.start(now); osc.stop(now + 0.13);
          break;
        case "gatling":
          osc.type = "square";
          osc.frequency.setValueAtTime(390, now);
          osc.frequency.exponentialRampToValueAtTime(140, now + 0.04);
Use code with caution.
gain.gain.setValueAtTime(0.04, now);
gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
osc.start(now); osc.stop(now + 0.04);
break;
case "coin":
osc.type = "sine";
osc.frequency.setValueAtTime(987, now);
osc.frequency.setValueAtTime(1318, now + 0.06);
gain.gain.setValueAtTime(0.08, now);
gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
osc.start(now); osc.stop(now + 0.22);
break;
case "build":
osc.type = "triangle";
osc.frequency.setValueAtTime(240, now);
osc.frequency.exponentialRampToValueAtTime(520, now + 0.12);
gain.gain.setValueAtTime(0.09, now);
gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
osc.start(now); osc.stop(now + 0.12);
break;
case "boss":
osc.type = "sawtooth";
osc.frequency.setValueAtTime(110, now);
osc.frequency.linearRampToValueAtTime(75, now + 0.45);
gain.gain.setValueAtTime(0.14, now);
gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
osc.start(now); osc.stop(now + 0.45);
break;
}
}
document.getElementById("mute-btn").onclick = () => {
initAudio();
soundMuted = !soundMuted;
document.getElementById("mute-btn").textContent = soundMuted ? "Sound: OFF" : "Sound: ON";
};
