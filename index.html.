<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3D Neon Bastion - Tower Defense (Expanded Edition)</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
  body {
    background: #05070f;
    color: #e0f7ff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    overflow: hidden;
  }
  #game-canvas { display: block; width: 100vw; height: 100vh; }

  /* HUD Top Bar */
  #hud-top {
    position: fixed; top: 14px; left: 14px; right: 14px;
    display: flex; justify-content: space-between; align-items: center;
    pointer-events: none; z-index: 10;
  }
  .hud-group {
    display: flex; gap: 12px; align-items: center;
    background: rgba(10, 16, 34, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.35);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
    padding: 8px 16px; border-radius: 8px;
    pointer-events: auto;
  }
  .stat { font-size: 14px; font-weight: 600; letter-spacing: 0.5px; }
  .stat span { color: #00f0ff; font-weight: 700; }
  .stat.gold span { color: #ffd700; }
  .stat.lives span { color: #ff477e; }

  button {
    background: rgba(0, 240, 255, 0.15);
    color: #00f0ff;
    border: 1px solid #00f0ff;
    padding: 6px 12px; border-radius: 6px;
    font-weight: 600; cursor: pointer;
    transition: all 0.15s ease;
  }
  button:hover:not(:disabled) {
    background: #00f0ff; color: #05070f;
    box-shadow: 0 0 12px #00f0ff;
  }
  button:disabled { opacity: 0.4; cursor: not-allowed; }
  button.danger { border-color: #ff477e; color: #ff477e; background: rgba(255, 71, 126, 0.12); }
  button.danger:hover:not(:disabled) { background: #ff477e; color: #fff; box-shadow: 0 0 12px #ff477e; }

  /* Tower Selection & Upgrade Panel */
  #hud-bottom {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    z-index: 10;
  }
  #tower-inspector {
    display: none;
    background: rgba(10, 16, 34, 0.92);
    border: 1px solid #00f0ff;
    padding: 10px 18px; border-radius: 8px;
    gap: 14px; align-items: center;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.25);
  }
  #tower-inspector.active { display: flex; }
  #build-bar {
    display: flex; gap: 10px;
    background: rgba(10, 16, 34, 0.88);
    border: 1px solid rgba(0, 240, 255, 0.35);
    padding: 10px 14px; border-radius: 10px;
  }
  .tower-card {
    background: rgba(18, 28, 56, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px; padding: 8px 12px;
    width: 145px; cursor: pointer; text-align: left;
    transition: all 0.15s ease;
  }
  .tower-card:hover { border-color: #00f0ff; transform: translateY(-2px); }
  .tower-card.selected {
    border-color: #00f0ff;
    background: rgba(0, 240, 255, 0.18);
    box-shadow: 0 0 14px rgba(0, 240, 255, 0.3);
  }
  .tower-card .t-name { font-weight: 700; font-size: 13px; margin-bottom: 2px; }
  .tower-card .t-cost { color: #ffd700; font-size: 12px; font-weight: 700; }
  .tower-card .t-desc { color: #9ab8d8; font-size: 11px; margin-top: 4px; line-height: 1.25; }

  #hint-text {
    font-size: 12px; color: #8ba8c7;
    background: rgba(5, 7, 15, 0.75);
    padding: 4px 12px; border-radius: 12px;
  }

  /* Start / Map & Difficulty Overlay */
  #overlay {
    position: fixed; inset: 0;
    background: radial-gradient(circle at center, rgba(12, 22, 48, 0.92), rgba(4, 6, 14, 0.98));
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    z-index: 50; text-align: center; padding: 20px;
  }
  #overlay h1 {
    font-size: 42px; letter-spacing: 3px; color: #00f0ff;
    text-shadow: 0 0 20px rgba(0, 240, 255, 0.6);
    margin-bottom: 8px;
  }
  #overlay p { color: #a8c5e5; margin-bottom: 24px; font-size: 15px; }
  .setup-section { margin-bottom: 22px; }
  .setup-section h3 {
    font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px;
    color: #7a9bc2; margin-bottom: 10px;
  }
  .btn-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .choice-btn {
    padding: 10px 18px; font-size: 14px;
    background: rgba(16, 26, 52, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #cde8ff;
  }
  .choice-btn.active {
    background: #00f0ff; color: #05070f;
    border-color: #00f0ff; box-shadow: 0 0 15px rgba(0, 240, 255, 0.5);
  }
  #start-btn {
    padding: 14px 36px; font-size: 16px; letter-spacing: 1.5px;
    background: #00f0ff; color: #05070f; border: none;
    box-shadow: 0 0 22px rgba(0, 240, 255, 0.5);
    margin-top: 8px;
  }
  #boss-banner {
    position: fixed; top: 68px; left: 50%; transform: translateX(-50%);
    background: rgba(255, 25, 85, 0.2); border: 1px solid #ff1955;
    color: #ff6b93; padding: 6px 20px; border-radius: 6px;
    font-weight: 700; letter-spacing: 1.5px; display: none; z-index: 15;
    text-shadow: 0 0 8px #ff1955;
  }
</style>
</head>
<body>

<div id="hud-top">
  <div class="hud-group">
    <div class="stat gold">Gold: <span id="ui-gold">180</span></div>
    <div class="stat lives">Lives: <span id="ui-lives">20</span></div>
    <div class="stat">Wave: <span id="ui-wave">1 / 50</span></div>
    <div class="stat">Map: <span id="ui-map">Neon Switchback</span></div>
