    <div class="tower-card" data-type="prism">
      <div class="t-name" style="color:#ff2a85;">Prism Beam</div>
      <div class="t-cost">$110</div>
      <div class="t-desc">Continuous laser that ramps damage the longer it locks on.</div>
    </div>
    <div class="tower-card" data-type="tesla">
      <div class="t-name" style="color:#b84dff;">Tesla Coil</div>
      <div class="t-cost">$135</div>
      <div class="t-desc">Arc lightning chaining across up to 4 nearby enemies.</div>
    </div>
    <div class="tower-card" data-type="mortar">
      <div class="t-name" style="color:#ff9e00;">Plasma Mortar</div>
      <div class="t-cost">$150</div>
      <div class="t-desc">Lobbed explosive shells dealing heavy AoE splash damage.</div>
    </div>
    <div class="tower-card" data-type="cryo">
      <div class="t-name" style="color:#5ce1e6;">Cryo Obelisk</div>
