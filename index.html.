  <div id="hint-text">Left-click grid to build | Click placed tower to upgrade/sell | Right-drag to orbit camera</div>
</div>

<div id="overlay">
  <h1>3D NEON BASTION</h1>
  <p>Survive 50 Waves, Master Unique Tower Arsenal &amp; Defeat 5 Mega-Bosses</p>

  <div class="setup-section">
    <h3>1. Select Battlefield Map</h3>
    <div class="btn-row" id="map-choices">
      <button class="choice-btn active" data-map="0">Neon Switchback (Classic)</button>
      <button class="choice-btn" data-map="1">Cyber Spiral (Long Core)</button>
      <button class="choice-btn" data-map="2">Twin Bastion Gauntlet (Tight)</button>
      <button class="choice-btn" data-map="3">Void Crossroad (High Risk)</button>
    </div>
  </div>

  <div class="setup-section">
    <h3>2. Select Economy &amp; Threat Difficulty</h3>
    <div class="btn-row" id="diff-choices">
      <button class="choice-btn" data-diff="Easy">Easy</button>
      <button class="choice-btn active" data-diff="Normal">Normal</button>
      <button class="choice-btn" data-diff="Hard">Hard</button>
      <button class="choice-btn" data-diff="Nightmare">Nightmare</button>
    </div>
  </div>

  <button id="start-btn">DEPLOY BASTION</button>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
